# ======= Custom ignored directories and files =======

# Auto-generated directories
/coverage/
/dist/
/public-*/

# Application data (databases etc.) - deliberately only the databases, narrower than .gitignore's
# /app-data/, so Cursor can still index the other local app-data files
/app-data/database/

# Playwright files
/.playwright-mcp/

# Secrets files
**/*.secrets.*
!**/*.secrets.example.*

# Vendored third-party files (frontend branches)
/frontend/src/resources/3rdparty/

# ======= Generic ignored directories and files =======

# Environment variables files
**/.env
**/.env.*
**/*.env

# Certificate and key files
**/*.crt
**/*.key
**/*.pem

# Archive files
*.tar
*.tar.gz
*.zip

# Backup directories and files
backup
*.backup
*.backup.temp
*.bak

# Cache and dependency directories
/.cache/
/node_modules/

# Log directories and files
logs
*.log

# Temporary directories and files
temp
tmp
*.tmp
