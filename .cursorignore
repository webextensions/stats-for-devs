# ======= Custom ignored directories and files =======

# Auto-generated directories
dist
/public-*/

# Application data (databases etc.)
/app-data/database/

# Secrets files
**/*.secrets.*
!**/*.secrets.example.*

# ======= Generic ignored directories and files =======

# Environment variables files
**/.env
**/.env.*
**/*.env

# Certificate and key files
**/*.crt
**/*.key
**/*.pem

# Archive files
*.tar
*.tar.gz
*.zip

# Backup directories and files
backup
*.backup
*.backup.temp
*.bak

# Cache and dependency directories
.cache
node_modules

# Log directories and files
logs
*.log

# Temporary directories and files
temp
tmp
*.tmp
