{
    "claudeCode.initialPermissionMode": "auto",

    // Run the editor's ESLint on the same Node the shell uses, via the workspace-relative symlink
    // created by "node --run setup:editor" (.vscode/soft-links/setup.sh). Without this, VS Code /
    // Cursor may pick a bundled or system Node and fail to load the flat config.
    // If it still does not work, replace the value with the absolute path of your Node binary:
    //     "eslint.runtime": "/home/<user-goes-here>/.nvm/versions/node/v24.15.0/bin/node",
    // Refs:
    //     * https://github.com/eslint-stylistic/eslint-stylistic/issues/661
    //     * https://github.com/eslint-stylistic/eslint-stylistic/issues/714
    //     * https://github.com/eslint-stylistic/eslint-stylistic/issues/765
    "eslint.runtime": "./.vscode/soft-links/node",

    // File Nesting
    // Ref: https://github.com/antfu/vscode-file-nesting-config#update-manually
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "*.css": "${capture}.css.map",
        "*.js": "${capture}.js.map",
        ".env": ".env.*",
        ".gitignore": ".cursorignore, .stylelintignore",
        ".nvmrc": ".auto-changelog, .block-non-keyboard-characters.suppressions.json, .live-css.config.cjs, .npmrc, babel.config.cjs, copy-files-from-to.cjson, eslint.config.cjs, eslint.config.js, eslint.markdown.config.js, knip.config.ts, revisit.json, stylelint.config.js, vitest.config.ts",
        "AGENTS.md": "CLAUDE.md",
        "package.json.ts": "package-lock.json, package-version.json, package.json",
        "README.md": "LICENSE, README*.md",
        "settings.json": "settings.example.json, settings.local.example.json, settings.local.json",
        "tsconfig.json": "tsconfig.tsbuildinfo"
    },

    // Keep the file watcher away from the churny local-database/log paths under app-data (the
    // PostgreSQL data directory and the SQLite -wal/-shm sidecars change constantly while the app
    // runs). Unlike the "search.exclude" globs below, watcher globs need the "**" suffix to cover
    // directory contents.
    "files.watcherExclude": {
        // // Required to avoid issue where the "Source Control" panel in Visual
        // // Studio Code keeps refreshing when MongoDB server is running in the
        // // background.
        // // To notice the original issue:
        // //     * launch the MongoDB server at the concerned path
        // //     * remove this watcher exclusion rule
        // //     * launch VS Code with "code --verbose"
        // //     * in VS Code, activate the "Git: Show Git Output" view to notice
        // //       the unwanted Git related activities by VS Code and the relevant
        // //       log entries
        // // Reference: https://github.com/Microsoft/vscode/issues/43234#issuecomment-365228599
        // //
        // // Note: Somehow, the "**/" in the beginning is required and it doesn't work without that
        // "**/app-data/database/mongodb/**": true,

        "app-data/database/**": true,
        "app-data/logs/**": true
    },

    // Let search see git-ignored files (local config, generated artifacts worth grepping), while
    // "search.exclude" keeps the genuinely noisy content out (mirror the globalIgnores list in
    // eslint.config.js; deliberate extras beyond that list: package-lock.json is tracked, so it
    // needs an explicit rule, app-data holds local databases/backups, .playwright-mcp holds
    // git-ignored agent artifacts, frontend/src/resources/3rdparty is the tracked vendored
    // third-party tree, matching the stylelint / knip / non-keyboard-characters exemption scope, and
    // tsconfig.tsbuildinfo is the incremental type-check cache written by tsc - matched at any depth
    // to also cover the per-package caches of the other branches).
    // Bare patterns match relative to the workspace root only, where these outputs live; a "**/"
    // prefix opts into any-depth matching. A trailing slash marks a directory and works on plain
    // names, but VS Code's glob treats it literally on wildcard patterns - "public-*/" would match
    // nothing - so "public-*" stays slash-less.
    "search.exclude": {
        // // https://github.com/Microsoft/vscode/issues/36438#issuecomment-337382427
        // // When "search.useIgnoreFiles" is set to true (its default value), use this rule to
        // // allow searching (and quick-opening) the files in the custom "node_modules" folder (the
        // // one which is not at the root level)
        // "**/node_modules": false, // Commented out this rule since we should not be using custom "node_modules" at sub-level

        ".playwright-mcp/": true,
        "**/.cache/": true,
        "**/temp/": true,
        "**/tmp/": true,
        "**/tsconfig.tsbuildinfo": true,
        "app-data/": true,
        "coverage/": true,
        "dist/": true,
        "frontend/src/resources/3rdparty/": true,
        "node_modules/": true,
        "package-lock.json": true,
        "public-*": true
    },
    "search.useIgnoreFiles": false,

    // Put the .vscode/soft-links/node symlink first on the integrated terminals' PATH, so commands
    // run there use the same Node as "eslint.runtime" above. Re-run "node --run setup:editor" after
    // switching Node versions ("nvm use") to refresh the link.
    "terminal.integrated.automationProfile.linux": {
        "env": {
            "PATH": "${workspaceFolder}/.vscode/soft-links:${env:PATH}"
        },
        "path": "/bin/bash"
    },
    "terminal.integrated.env.linux": {
        "PATH": "${workspaceFolder}/.vscode/soft-links:${env:PATH}"
    }
}
